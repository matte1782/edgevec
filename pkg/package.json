{
  "name": "edgevec",
  "type": "module",
  "description": "High-performance embedded vector database for Browser, Node, and Edge",
  "version": "0.9.0",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/matte1782/edgevec"
  },
  "files": [
    "*.js",
    "*.d.ts",
    "edgevec_bg.wasm",
    "snippets",
    "react",
    "vue",
    "LICENSE-APACHE",
    "LICENSE-MIT",
    "README.md"
  ],
  "main": "index.js",
  "types": "index.d.ts",
  "sideEffects": [
    "./snippets/*"
  ],
  "keywords": [
    "vector",
    "database",
    "wasm",
    "hnsw",
    "similarity-search"
  ],
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js"
    },
    "./wasm": {
      "types": "./edgevec.d.ts",
      "import": "./edgevec.js"
    },
    "./react": {
      "types": "./react/index.d.ts",
      "import": "./react/index.js"
    },
    "./vue": {
      "types": "./vue/index.d.ts",
      "import": "./vue/index.js"
    },
    "./*": "./*"
  },
  "peerDependencies": {
    "react": ">=18",
    "vue": ">=3.3"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  }
}
